/**
 * 🩸 SCREEN 1 — THE GATE
 * Drag & Drop + forensics + streaming hash + recent cache
 */
import React, { useCallback, useEffect, useRef, useState } from 'react';
import { UploadCloud, FileSearch, ShieldCheck, AlertTriangle, Clock, Settings2, Flame, Database, Cpu, Package, Boxes } from 'lucide-react';
import { ApkForensics, GateOptions, GateRecord, analyzeApkStructure, cacheList, cachePut, streamSha256, validateFile } from '../utils/gateUtils';

interface GateScreenProps {
  onStart: (file: File, forensics: ApkForensics, sha256: string, opts: GateOptions) => void;
}

const fmtBytes = (n: number) => {
  if (n > 1e9) return (n / 1e9).toFixed(2) + ' GB';
  if (n > 1e6) return (n / 1e6).toFixed(2) + ' MB';
  if (n > 1e3) return (n / 1e3).toFixed(1) + ' KB';
  return n + ' B';
};

export const GateScreen: React.FC<GateScreenProps> = ({ onStart }) => {
  const [dragOver, setDragOver] = useState(false);
  const [busy, setBusy] = useState(false);
  const [pct, setPct] = useState(0);
  const [error, setError] = useState<string | null>(null);
  const [file, setFile] = useState<File | null>(null);
  const [forensics, setForensics] = useState<ApkForensics | null>(null);
  const [sha, setSha] = useState('');
  const [cached, setCached] = useState(false);
  const [recent, setRecent] = useState<GateRecord[]>([]);
  const [drawer, setDrawer] = useState(false);
  const [opts, setOpts] = useState<GateOptions>({ deepNative: true, il2cppProbe: true, deobStrings: true });
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => { cacheList().then(setRecent).catch(() => {}); }, []);

  const processFile = useCallback(async (f: File) => {
    setError(null); setFile(null); setForensics(null); setSha(''); setCached(false);
    const vErr = validateFile(f);
    if (vErr) { setError(vErr); return; }
    setBusy(true); setPct(0);
    try {
      const fore = await analyzeApkStructure(f);
      if (!fore.validZip) { setError(fore.errors.join(' | ')); setBusy(false); return; }
      const hash = await streamSha256(f, setPct);
      const rec = await cacheList();
      const hit = rec.find(r => r.id === hash);
      setFile(f); setForensics(fore); setSha(hash); setCached(!!hit);
      if (!hit) await cachePut({ id: hash, name: f.name, size: f.size, sha256: hash, ts: Date.now(), forensics: fore });
      setRecent(await cacheList());
    } catch (e: any) {
      setError('Processing fail: ' + (e?.message || e));
    }
    setBusy(false);
  }, []);

  const onDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault(); setDragOver(false);
    const f = e.dataTransfer.files?.[0];
    if (f) processFile(f);
  }, [processFile]);

  return (
    <div className="min-h-screen bg-zinc-950 text-zinc-100 flex flex-col items-center justify-center p-4 sm:p-8 space-y-6">
      {/* Header */}
      <div className="text-center space-y-2">
        <div className="flex items-center justify-center space-x-2">
          <span className="flex items-center space-x-1.5 px-2.5 py-1 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-mono text-[11px] font-bold uppercase tracking-wider">
            <Flame className="w-3.5 h-3.5" /><span>Screen 1 / The Gate</span>
          </span>
        </div>
        <h1 className="text-2xl sm:text-3xl font-black tracking-tight">APK POSTMORTEM STUDIO</h1>
        <p className="text-xs text-zinc-400">APK drop karo — forensics, hash aur structure foran hazir.</p>
      </div>

      {/* Drop Zone */}
      <div
        onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
        onDragLeave={() => setDragOver(false)}
        onDrop={onDrop}
        onClick={() => inputRef.current?.click()}
        className={`w-full max-w-2xl cursor-pointer rounded-2xl border-2 border-dashed p-10 sm:p-14 flex flex-col items-center justify-center space-y-4 transition-all ${
          dragOver ? 'border-emerald-400 bg-emerald-500/10 animate-pulse' : 'border-zinc-700 bg-zinc-900/60 hover:border-zinc-500'
        }`}
      >
        <UploadCloud className={`w-12 h-12 ${dragOver ? 'text-emerald-400' : 'text-zinc-500'}`} />
        <div className="text-sm font-bold font-mono text-zinc-200">APK YAHAN DRAG & DROP KARO</div>
        <div className="text-[11px] text-zinc-500 font-mono">.apk • .xapk • .apks • .zip — ya tap kar ke browse karo</div>
        <input ref={inputRef} type="file" accept=".apk,.xapk,.apks,.zip" className="hidden"
          onChange={(e) => { const f = e.target.files?.[0]; if (f) processFile(f); }} />
      </div>

      {/* Hashing progress */}
      {busy && (
        <div className="w-full max-w-2xl space-y-2">
          <div className="flex justify-between text-[11px] font-mono text-emerald-400">
            <span>STREAMING SHA-256 + FORENSICS...</span><span>{pct}%</span>
          </div>
          <div className="h-2 rounded-full bg-zinc-800 overflow-hidden">
            <div className="h-full bg-emerald-500 transition-all" style={{ width: `${pct}%` }} />
          </div>
        </div>
      )}

      {/* Error card */}
      {error && (
        <div className="w-full max-w-2xl p-4 rounded-xl bg-red-950/40 border border-red-700/50 flex items-center space-x-3">
          <AlertTriangle className="w-5 h-5 text-red-400 shrink-0" />
          <span className="text-xs font-mono text-red-300">{error}</span>
        </div>
      )}

      {/* Target Card */}
      {forensics && file && (
        <div className="w-full max-w-2xl p-5 rounded-2xl bg-zinc-900/80 border border-zinc-800 space-y-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-2">
              <FileSearch className="w-4 h-4 text-emerald-400" />
              <span className="text-sm font-bold font-mono">{file.name}</span>
            </div>
            <span className="text-[11px] font-mono text-zinc-400">{fmtBytes(file.size)}</span>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <div className="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-center">
              <div className="text-lg font-black font-mono text-emerald-400">{forensics.dexCount}</div>
              <div className="text-[10px] text-zinc-500 uppercase">DEX</div>
            </div>
            <div className="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-center">
              <div className="text-lg font-black font-mono text-cyan-400">{forensics.soCount}</div>
              <div className="text-[10px] text-zinc-500 uppercase">Native .so</div>
            </div>
            <div className="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-center">
              <div className="text-lg font-black font-mono text-amber-400">{forensics.resCount}</div>
              <div className="text-[10px] text-zinc-500 uppercase">Resources</div>
            </div>
            <div className="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-center">
              <div className="text-lg font-black font-mono text-purple-400">{forensics.assetCount}</div>
              <div className="text-[10px] text-zinc-500 uppercase">Assets</div>
            </div>
          </div>
          <div className="p-2 rounded-lg bg-black border border-zinc-800 text-[10px] font-mono text-zinc-500 break-all">
            SHA-256: {sha}
          </div>
          {cached && (
            <div className="flex items-center space-x-2 text-[11px] font-mono text-cyan-300">
              <Database className="w-3.5 h-3.5" /><span>Yeh APK pehle se scanned hai — report cache mein mojood!</span>
            </div>
          )}
          {forensics.splitBase && (
            <div className="flex items-center space-x-2 text-[11px] font-mono text-amber-300">
              <Package className="w-3.5 h-3.5" /><span>Split/App-Bundle detect hua: {forensics.splitBase}</span>
            </div>
          )}
          {forensics.errors.length > 0 && forensics.validZip && (
            <div className="text-[11px] font-mono text-amber-300">⚠ {forensics.errors.join(' | ')}</div>
          )}

          {/* Advanced drawer */}
          <button onClick={() => setDrawer(!drawer)} className="flex items-center space-x-2 text-[11px] font-mono text-zinc-400 hover:text-zinc-200">
            <Settings2 className="w-3.5 h-3.5" /><span>Advanced Scanning Options</span>
          </button>
          {drawer && (
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
              {([['deepNative','Deep Native Autopsy'],['il2cppProbe','IL2CPP Probe'],['deobStrings','String Deobfuscation']] as [keyof GateOptions, string][]).map(([k, label]) => (
                <button key={k} onClick={() => setOpts(o => ({ ...o, [k]: !o[k] }))}
                  className={`p-2 rounded-lg border text-[11px] font-mono font-bold transition-all ${opts[k] ? 'bg-emerald-500/20 border-emerald-500/50 text-emerald-300' : 'bg-zinc-950 border-zinc-800 text-zinc-500'}`}>
                  {opts[k] ? 'ON' : 'OFF'} — {label}
                </button>
              ))}
            </div>
          )}

          <button
            onClick={() => onStart(file, forensics, sha, opts)}
            className="w-full py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-black text-sm tracking-wide shadow-lg transition-all flex items-center justify-center space-x-2">
            <Cpu className="w-4 h-4" /><span>⚡ START POSTMORTEM</span>
          </button>
        </div>
      )}

      {/* Recent analyses */}
      {recent.length > 0 && (
        <div className="w-full max-w-2xl space-y-2">
          <div className="flex items-center space-x-2 text-[11px] font-mono text-zinc-500 uppercase tracking-wider">
            <Clock className="w-3.5 h-3.5" /><span>Recent Analyses</span>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {recent.slice(0, 6).map(r => (
              <div key={r.id} className="p-2.5 rounded-lg bg-zinc-900/60 border border-zinc-800 flex items-center justify-between">
                <div className="min-w-0">
                  <div className="text-[11px] font-mono font-bold text-zinc-200 truncate">{r.name}</div>
                  <div className="text-[10px] font-mono text-zinc-500">{fmtBytes(r.size)} • {new Date(r.ts).toLocaleDateString()}</div>
                </div>
                <Boxes className="w-4 h-4 text-zinc-600 shrink-0" />
              </div>
            ))}
          </div>
        </div>
      )}

      <div className="flex items-center space-x-2 text-[10px] font-mono text-zinc-600">
        <ShieldCheck className="w-3.5 h-3.5" /><span>100% LOCAL PROCESSING — koi upload nahi</span>
      </div>
    </div>
  );
};